<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_main">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PERSONAL AI SYSTEM" android:textColor="#91A9B8" android:textSize="18sp" android:letterSpacing="0.28"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="JARVIS" android:textColor="#4DE4FF" android:textSize="42sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp" android:src="@drawable/jarvis_core"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:text="ONLINE"
        android:textColor="#4DE4FF" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.18"/>

    <Button android:id="@+id/wakeButton" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="18dp" android:background="@drawable/bg_button" android:text="START OFFLINE WAKE MODE"
        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
    <TextView android:id="@+id/offlineInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="8dp" android:text="No login or key. First start downloads the offline model once (~40 MB)."
        android:textColor="#91A9B8" android:textSize="14sp"/>

    <TextView android:id="@+id/engineDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:padding="10dp"
        android:text="Status: START dabaiye" android:textColor="#4DE4FF"
        android:textSize="14sp" android:background="@drawable/bg_panel"/>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp" android:background="@drawable/bg_panel" android:padding="16dp">
        <LinearLayout android:id="@+id/chatContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/micButton" android:layout_width="68dp" android:layout_height="60dp" android:background="@drawable/bg_button" android:text="🎤" android:textSize="24sp"/>
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_input"
            android:hint="Jarvis se baat kijiye" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#78909C" android:singleLine="true"/>
        <Button android:id="@+id/sendButton" android:layout_width="88dp" android:layout_height="60dp" android:background="@drawable/bg_button"
            android:text="SEND" android:textColor="#FFFFFF" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
